patch=1,EE,000815A8,word,00000000

// ...and the step of motion interpolators (walking, camera), which ignore the timestep.
// 0x815F8 is 1 while the field runs at 60 FPS.
patch=1,EE,0016BCB0,word,08020580
patch=1,EE,00081600,word,C4820000
patch=1,EE,00081604,word,3C030008

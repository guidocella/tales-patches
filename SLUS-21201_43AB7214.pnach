// Halve field speed: the field task's timestep (animations, effects)...
// This includes menus (bit 0 of the field's +0x34, which also stops its actors), whose cursors, key repeat, sprite animations
// and tweens are fixed below.
// 0x815FC is set by the field task on frames it updates the field at 60 FPS.
patch=1,EE,00168864,word,08020560
patch=1,EE,00081580,word,92020034
patch=1,EE,00081584,word,30420001
patch=1,EE,00081588,word,00000000   // was bnez v0 (menu open: stay at 30 FPS)

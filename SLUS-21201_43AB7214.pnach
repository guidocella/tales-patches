// ...and the animation code, which multiplies the playback speed by the timestep twice (FUN_001cd7c0 stores speed * timestep, then
// FUN_001c3ef0 multiplies it by the timestep again), so divide it back out before it's stored. Without this, animations
// that aren't restarted every frame slow to a stop, which stalled events waiting for them.
patch=1,EE,001CDA8C,word,080205D8
patch=1,EE,001CDA90,word,00000000
patch=1,EE,00081760,word,44800000
patch=1,EE,00081764,word,4600A832
patch=1,EE,00081768,word,45010002

patch=1,EE,00081770,word,4615A503
patch=1,EE,00081774,word,0807362F
patch=1,EE,00081778,word,E6740064

// ...and the timestep FUN_001eaa70 passes to the map's draw, which advances the map's animation time (e.g. flowing water).
// Only this call: other draw calls there may skip work when the timestep is below 1.
patch=1,EE,001EAA94,word,0C020604   // jal 0x81810
patch=1,EE,00081810,word,C60C0024   // lwc1 f12,0x24(s0)
patch=1,EE,00081814,word,3C010008   // lui at,0x8
patch=1,EE,00081818,word,902115F8   // lbu at,0x15F8(at)
patch=1,EE,0008181C,word,10200004   // beqz at,0x81830
patch=1,EE,00081820,word,3C013F00   // lui at,0x3f00
patch=1,EE,00081824,word,44810000   // mtc1 at,f0
patch=1,EE,00081828,word,00000000
patch=1,EE,0008182C,word,46006302   // mul.s f12,f12,f0
patch=1,EE,00081830,word,03E00008   // jr ra
patch=1,EE,00081834,word,00000000

// ...and the timestep of 2D layers (e.g. the event overlay, letterbox bars and the fade out of the victory screen), which is
// always 1 outside the field, in FUN_00164d40. 0x815FE is 1 while the game runs at 60 FPS, in the field, battles or the victory screen.
patch=1,EE,00164D70,word,080205E0
patch=1,EE,00164D74,word,3C023F80
patch=1,EE,00081780,word,44826800   // mtc1 v0,f13
patch=1,EE,00081784,word,3C020008   // lui v0,0x8
patch=1,EE,00081788,word,904215FE   // lbu v0,0x15FE(v0)
patch=1,EE,0008178C,word,10400005   // beqz v0,0x817a4
patch=1,EE,00081790,word,3C023F00   // lui v0,0x3f00
patch=1,EE,00081794,word,44820000   // mtc1 v0,f0
patch=1,EE,00081798,word,00000000
patch=1,EE,0008179C,word,46006302   // mul.s f12,f12,f0
patch=1,EE,000817A0,word,46006B42   // mul.s f13,f13,f0
patch=1,EE,000817A4,word,0805935E   // j 0x164d78
patch=1,EE,000817A8,word,00000000

// ...and event and skit portraits, whose update (FUN_001e82d0) counts updates for its moves (+0x78 against +0x74), fades (+0x3c
// per update), scaling (+0xe8 against +0xec), blinking and lip sync: at 60 FPS, run it every frame with half steps, but on alternate
// frames (0x815F4 is the toggle, 0x815F5 is set on these frames) don't count updates or blink (0x815E3 is set while doing so).

[Disable random encounters]
description=Press R2 to start an encounter
patch=1,EE,202D46A4,extended,00000000
patch=1,EE,D04969DC,extended,0000FDFF
patch=1,EE,202D46A4,extended,10000002

// Original cheats

[Don't consume TP in battle]
patch=1,EE,2034F9B4,extended,0000282D

[No damage to the party]
// FUN_0036c1a0 applies a hit to a battle character (party or enemy): it adds minus the damage (+0x11b8) to the HP with
// FUN_002bb050(chr+0x18, delta), which clamps it to [0, max HP] and KOs at 0. Call a cave instead that zeroes negative
// deltas when the flag for the character's side is set: 0x80F41 for party members (character ID at +4 is 1-9), 0x80F40
// for enemies (IDs in the hundreds). Damage numbers and hit reactions still show. "No damage to enemies" writes
// the same cave with the other flag, so the two can be enabled together.
patch=1,EE,0036C37C,word,0C0203C0   // jal 0x80f00 (was jal 0x2bb050)
patch=1,EE,00080F00,word,8E680004   // lw t0,4(s3)
patch=1,EE,00080F04,word,2508FFFF   // addiu t0,t0,-1
patch=1,EE,00080F08,word,2D080009   // sltiu t0,t0,9
patch=1,EE,00080F0C,word,3C090008   // lui t1,0x8
patch=1,EE,00080F10,word,01284821   // addu t1,t1,t0
patch=1,EE,00080F14,word,91290F40   // lbu t1,0xf40(t1)
patch=1,EE,00080F18,word,00A0402A   // slt t0,a1,zero
patch=1,EE,00080F1C,word,01094024   // and t0,t0,t1
patch=1,EE,00080F20,word,0008280B   // movn a1,zero,t0
patch=1,EE,00080F24,word,080AEC14   // j 0x2bb050
patch=1,EE,00080F28,word,00000000
patch=1,EE,00080F41,byte,01

[No damage to enemies]
// See "No damage to the party".
patch=1,EE,0036C37C,word,0C0203C0   // jal 0x80f00 (was jal 0x2bb050)
patch=1,EE,00080F00,word,8E680004   // lw t0,4(s3)
patch=1,EE,00080F04,word,2508FFFF   // addiu t0,t0,-1
patch=1,EE,00080F08,word,2D080009   // sltiu t0,t0,9
patch=1,EE,00080F0C,word,3C090008   // lui t1,0x8
patch=1,EE,00080F10,word,01284821   // addu t1,t1,t0
patch=1,EE,00080F14,word,91290F40   // lbu t1,0xf40(t1)
patch=1,EE,00080F18,word,00A0402A   // slt t0,a1,zero
patch=1,EE,00080F1C,word,01094024   // and t0,t0,t1
patch=1,EE,00080F20,word,0008280B   // movn a1,zero,t0
patch=1,EE,00080F24,word,080AEC14   // j 0x2bb050
patch=1,EE,00080F28,word,00000000
patch=1,EE,00080F40,byte,01

[Senel learns Lord of Creation/万物神追撃]
patch=1,EE,704A83B4,extended,00000002

[Fully heal the party after battles]
// At the end of a battle (won or escaped), FUN_0037eac0 copies each battle member's HP back to their party record with
// FUN_0028b730, which clamps it to the max HP. Pass 0x7fff instead. KO is HP 0: for KO'd members, take the path for living
// ones, which revives them (FUN_0028bd80) before setting the HP, and skip setting the HP back to 0 (FUN_0028bdd0) when
// bit 0 of their battle status flags (+0x11c) is set. (FUN_00367d10 does the same sync when opening a battle menu's
// submenu: leave it alone.)
patch=1,EE,0037EB68,word,00000000   // was blezl v0 (HP <= 0: KO'd)
patch=1,EE,0037EB88,word,24057FFF   // li a1,0x7fff (was lh a1,2(s1))
patch=1,EE,0037EBB0,word,00000000   // was bnezl v0 (KO flag)

[Run speed 2x]
// The field's player control (FUN_001ce110) moves the player by the stick times 0.25 each update.
patch=1,EE,001CE178,word,3C033F00   // lui v1,0x3f00 (0.25 * 2)
// The world map's walking (FUN_0020a150) moves the player by the stick times the speed (+0x58) when running: also multiply it
// by 2 (walking, below 0.7 of the stick, is unchanged).
patch=1,EE,0020A5EC,word,0C020400   // jal 0x81000
patch=1,EE,00081000,word,24100001   // li s0,1
patch=1,EE,00081004,word,3C014000   // lui at,0x4000
patch=1,EE,00081008,word,44810800   // mtc1 at,f1
patch=1,EE,0008100C,word,00000000

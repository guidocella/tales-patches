patch=1,EE,001F96E0,word,2C61003C   // sltiu at,v1,60

[24 arte slots]
description=Arte menu: left/right for pages 2-4 (L2, R2, L2+R2). Shortcuts are on the right stick.
// Each character has a 0x54-byte struct at 0x4A7E4C + id * 0x54 (id 1-8; pointed to by the objects at 0x4E8C00[id]).
// +0x36..+0x40 are six u16 slots, (arte owner id << 8) | (arte index + 1), 0 = empty:
//   slot 0 X, slot 1 up+X, slot 2 left/right+X, slot 3 down+X, slot 4 R2 shortcut, slot 5 L2 shortcut,
// and +0x42/+0x43 are the user (owner id) of the slot 4/5 shortcut, 0 = none. Everything reads and writes them through
// FUN_0028e6a0 (get slot), FUN_0028e720 (set), FUN_0028e7a0 (clear), FUN_0028e830 (get user) and FUN_0028e870 (set user),
// which take the character object (a pointer to the struct pointer) and the slot.
//
// When a battle starts or the menu opened from a battle closes, FUN_00367e40/FUN_00369040 copy them to the battle actor:
// actor+4 is the character id, actor+0xAB8.. the arte index per direction (neutral, left/right, up, down), and
// actor+0xAA0/+0xAAC the L2/R2 shortcut as (enabled, arte index, user id) words. With B = actor+0x598, FUN_0037c3c0 starts
// the arte at B+0x520[direction] while X is held in semi-auto control mode (FUN_002a1360 is its copy for manual), and
// FUN_002d38f0 starts the shortcut at B+0x508 (L2) or B+0x514 (R2) when L2 or R2 is pressed. Both read the pad through FUN_00152ff0 (held) and FUN_00153010 (pressed) of the pad struct at
// 0x4969c0 + port * 0x1C0, which also has the analog sticks as floats (+0x168 RX, +0x16C RY, -1 = up).
//
// Pages 2-4
// ---------
// Pages 2-4 (L2, R2, L2+R2) are stored in the same format as the struct's +0x36..+0x43 in 16 bytes per page at
// 0x4A8A10 + (id * 3 + page - 1) * 16. That's the unused tail of the 0x800-byte array of script variables at 0x4A88B0,
// whose variable table (0x14B7E50) only uses bits 0-2815 (up to 0x4A8A0F), so the slots are saved with the game.
//
// The menu: left/right changes the page (0x80690); while it isn't 0, the slot accessors are redirected to the page's
// storage, so the menu's display and assignment code work unchanged. The row icons are re-laid out per page from a table.
// The page goes back to 0 when the menu is left or destroyed.
//
// Battle: L2/R2 held select the page; on pages 2-4 a held direction counts as X. The shortcuts are triggered by the right
// stick (up = the old L2 slot, down = the old R2 slot) instead of L2/R2.

patch=1,EE,0028E6A0,word,080201A8   // j 0x806a0
patch=1,EE,0028E6A4,word,00000000   // nop
patch=1,EE,0028E720,word,080201BF   // j 0x806fc

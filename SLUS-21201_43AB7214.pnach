// (FUN_002d4410, also called by the world map) also counts down the updates an item that changes the encounter rate lasts
// (0x4a7e1c): at 60 FPS count on alternate updates (0x815E1 is the toggle). t1 is the decrement.
patch=1,EE,002D4410,word,08020740   // j 0x81d00
patch=1,EE,002D4414,word,27BDFFE0   // addiu sp,sp,-0x20

<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet build -c Release [-p:Game=/path/to/Tales of Xillia Remastered]; needs BepInEx 6 (IL2CPP) installed there -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>XilliaPatches</AssemblyName>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <OutDir>$(MSBuildProjectDirectory)</OutDir>
    <Game Condition="'$(Game)' == ''">/mnt/hdd/games/steamapps/common/Tales of Xillia Remastered</Game>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(Game)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(Game)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
  </ItemGroup>
</Project>

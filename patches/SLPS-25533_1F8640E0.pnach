patch=1,EE,00090208,word,3421AAAB   // ori at,at,0xaaab (4/3)
patch=1,EE,0009020C,word,44810800   // mtc1 at,f1
patch=1,EE,00090210,word,46010002   // mul.s f0,f0,f1
patch=1,EE,00090214,word,08056F84   // j 0x15be10
patch=1,EE,00090218,word,E4A00020   // swc1 f0,0x20(a1)

// Keep the portraits where they were on the stretched screen, farther apart: FUN_001e7c10 positions them with
// FUN_00130770, so scale their x by 4/3 like the 3D-anchored nodes (0x90140).
patch=1,EE,001E8250,word,0C024050   // jal 0x90140

// Emotion balloons over actors (the exclamation mark, speech balloons: FUN_0021b520) project the actor's position plus their
// offset and place their node there with FUN_00130770: scale their x by 4/3 too, or they drift toward the center.
patch=1,EE,0021B87C,word,0C024050   // jal 0x90140

// World map HUD: move it toward the screen's edges by scaling its x by 4/3 (0x90140). The clock (FUN_00213cf0) and the
// minimap (FUN_00293fe0) position each of their nodes at their x - 256 with FUN_00130770...
patch=1,EE,00214034,word,0C024050   // jal 0x90140
patch=1,EE,002140C0,word,0C024050   // jal 0x90140
patch=1,EE,0021414C,word,0C024050   // jal 0x90140

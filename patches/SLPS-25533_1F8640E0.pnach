patch=1,EE,002AD864,word,3C0243DD   // lui v0,0x43dd (442, was 360)

// The message window's "next" cursor (FUN_0027c9f0) is placed at x 224 * flag - 14 from the center: under the box, or at
// the bottom right in events. Move the latter from 210 to 295, as far from the 16:9 edge as it was from the 4:3 one.
patch=1,EE,0027D870,word,00051023   // subu v0,zero,a1 (0 or -1)
patch=1,EE,0027D878,word,30420135   // andi v0,v0,309
patch=1,EE,0027D880,word,00000000   // nop (was sll v0,v0,5)

// Menu backgrounds (FUN_002398a0 draws a textured quad node): fill the sides. Full-width quads (x 0, width 512: the
// gradient behind the main menu, the gray bars) are stretched to x -86..598, and full-height columns at the edges
// (the shop's checkerboard, 56 px tiles) are repeated outward to the same edges. Cave at 0x91800 (0x90250+ is the
// boot loader's heap state, so this goes past its data). Event CGs over the field (512x512 at x -256) get a black copy of
// themselves (same alpha, for fades) drawn first on each side, so the 3D field doesn't show beside them. Source: bg-cave.s.

patch=1,EE,000900E4,word,E7A50090   // swc1 f5,0x90(sp)
patch=1,EE,000900E8,word,0808E41A   // j 0x239068
patch=1,EE,000900EC,word,46001024   // cvt.w.s f0,f2

// Scrolling lists (FUN_002791d0, e.g. the save files) do the same with their rectangle at sp+0x28 (x) and sp+0x30 (width).
patch=1,EE,00279208,word,08024088   // j 0x90220
patch=1,EE,0027920C,word,C4420000   // lwc1 f2,0(v0) (x)

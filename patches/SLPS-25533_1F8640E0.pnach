patch=1,EE,0009018C,word,24410100   // addiu at,v0,0x100
patch=1,EE,00090190,word,14200002   // bnez at,0x9019c
patch=1,EE,00090194,word,00000000
patch=1,EE,00090198,word,2402FEAA   // li v0,-342
patch=1,EE,0009019C,word,080D8B03   // j 0x362c0c
patch=1,EE,000901A0,word,44820000   // mtc1 v0,f0
patch=1,EE,00362C80,word,08024070   // j 0x901c0
patch=1,EE,00362C84,word,86020010   // lh v0,0x10(s0) (x1)
patch=1,EE,000901C0,word,8601000C   // lh at,0xc(s0) (x0)
patch=1,EE,000901C4,word,24210100   // addiu at,at,0x100
patch=1,EE,000901C8,word,14200004   // bnez at,0x901dc
patch=1,EE,000901CC,word,38410100   // xori at,v0,0x100

patch=1,EE,00090234,word,46041082   // mul.s f2,f2,f4
patch=1,EE,00090238,word,46031080   // add.s f2,f2,f3
patch=1,EE,0009023C,word,C7A50030   // lwc1 f5,0x30(sp) (width)

patch=1,EE,00090244,word,E7A50030   // swc1 f5,0x30(sp)
patch=1,EE,00090248,word,0809E484   // j 0x279210
patch=1,EE,0009024C,word,46001024   // cvt.w.s f0,f2

// 2D nodes anchored to a 3D point (FUN_001eba90, e.g. the battle target marker) are placed where it projects: scale their x by
// 4/3 so that the narrower 2D projection puts them back on it.
patch=1,EE,001EBB70,word,0C024050   // jal 0x90140
patch=1,EE,00090140,word,3C013FAA   // lui at,0x3faa
patch=1,EE,00090144,word,3421AAAB   // ori at,at,0xaaab (4/3)
patch=1,EE,00090148,word,44810000   // mtc1 at,f0
patch=1,EE,0009014C,word,0804C1DC   // j 0x130770
patch=1,EE,00090150,word,46006302   // mul.s f12,f12,f0

// Sprite lists (FUN_00362930, e.g. the climax combo cut-ins) draw each sprite from its x0 (+0x14) and x1 (+0x18): stretch
// sprites that span the whole screen (-256 to 256), like the cut-ins' bands, to -342 to 342 so that they still do.
patch=1,EE,00362C04,word,08024060   // j 0x90180
patch=1,EE,00362C08,word,8602000C   // lh v0,0xc(s0) (x0)

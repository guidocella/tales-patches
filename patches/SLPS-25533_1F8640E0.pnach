patch=1,EE,002AD4E8,word,3C024342   // lui v0,0x4342
patch=1,EE,002AD4F4,word,3C0243AD   // lui v0,0x43ad
// ...and FUN_002ad800 their text at x 8 (enemies, from -144) or 360 (party, from 512).
patch=1,EE,002AD834,word,3C02C362   // lui v0,0xc362 (-226, was -144)
patch=1,EE,002AD844,word,3C024414   // lui v0,0x4414 (592, was 512)

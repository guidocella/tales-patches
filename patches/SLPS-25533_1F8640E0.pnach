patch=1,EE,002942FC,word,0C024050   // jal 0x90140
// ...and the skit notice is created at x 236.
patch=1,EE,00210BF0,word,3C02439D   // lui v0,0x439d (314, was 0x436c)

// Field HUD: the action prompt at the bottom right (FUN_002830b0) and the town name at the bottom left (FUN_00283710) are
// placed when they're created: scale their x by 4/3 too.
patch=1,EE,00283590,word,0C024050   // jal 0x90140
patch=1,EE,00283EA4,word,0C024050   // jal 0x90140

// Battle HUD: the control mode at the top right (FUN_00365xxx) is placed at x 136 (to 240): move it to 216 (to 320)...
patch=1,EE,003650C8,word,240500D8   // li a1,0xd8 (was 0x88)
// ...and the enemy names (FUN_00343060) slide in to 512 - 232 (box from 24 to 248 from the center): slide them 82 farther.
patch=1,EE,00343134,word,24020252   // li v0,0x252 (was 0x200)
// The combo counters (FUN_002acb40) also move 82 farther from the center: the party's on the right, the enemies' on the left.
// FUN_002ad1e0 draws their bars at +-112 from the center (sliding in from +-264)...
patch=1,EE,002AD2F8,word,3C024342   // lui v0,0x4342 (194, was 112)
patch=1,EE,002AD2FC,word,3C024342   // lui v0,0x4342
patch=1,EE,002AD308,word,3C0243AD   // lui v0,0x43ad (346, was 264)

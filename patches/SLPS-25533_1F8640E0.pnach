gametitle=Tales of Legendia (Japan)

[Widescreen 16:9]
gsaspectratio=16:9
author=Arapapa

//Widescreen hack 16:9

//ae47613f 00000045 00000045
patch=1,EE,203D5820,extended,3f266666 //3f6147ae

//abaaaa3e 8988083e da0d5d3d
patch=1,EE,203BA330,extended,40133333 //3eaaaaab

// 2D layers (FUN_001eb170 draws them): widen their orthographic projection (FUN_0015ece0) from x = +-2047.5 to +-2730.
patch=1,EE,001EB2C8,word,0C024010   // jal 0x90040
patch=1,EE,00090040,word,3C013FAA   // lui at,0x3faa
patch=1,EE,00090044,word,3421AAAB   // ori at,at,0xaaab (4/3)
patch=1,EE,00090048,word,44810000   // mtc1 at,f0
patch=1,EE,0009004C,word,46006302   // mul.s f12,f12,f0
patch=1,EE,00090050,word,08057B38   // j 0x15ece0
patch=1,EE,00090054,word,46006B42   // mul.s f13,f13,f0

// Text isn't drawn through the projection: FUN_0022e040 draws a glyph with GS coordinates (centered on 2048). Scale its left
// edge around the center and its width by 0.75, except for text rendered into a texture (by FUN_001f7340, FUN_00206cb0 and
// FUN_003335d0, like the town names), which is narrowed when the texture is drawn: it's drawn at Z -16 (font +0xbc).
patch=1,EE,0022E56C,word,08024020   // j 0x90080
patch=1,EE,0022E570,word,46032180   // add.s f6,f4,f3 (left edge)
patch=1,EE,00090080,word,8EA100BC   // lw at,0xbc(s5)
patch=1,EE,00090084,word,24210010   // addiu at,at,0x10
patch=1,EE,00090088,word,10200008   // beqz at,0x900ac
patch=1,EE,0009008C,word,3C014500   // lui at,0x4500
patch=1,EE,00090090,word,44813800   // mtc1 at,f7 (2048)
patch=1,EE,00090094,word,3C013F40   // lui at,0x3f40
patch=1,EE,00090098,word,44814000   // mtc1 at,f8 (0.75)
patch=1,EE,0009009C,word,46073181   // sub.s f6,f6,f7
patch=1,EE,000900A0,word,46083182   // mul.s f6,f6,f8
patch=1,EE,000900A4,word,46073180   // add.s f6,f6,f7
patch=1,EE,000900A8,word,46081082   // mul.s f2,f2,f8 (width)
patch=1,EE,000900AC,word,0808B95D   // j 0x22e574
patch=1,EE,000900B0,word,46061140   // add.s f5,f2,f6 (right edge)

// Text nodes (FUN_0023d2a0) clip their text to the intersection of the GS scissor and their screen rectangle from
// FUN_00238850 (+8 x, +0x10 width), which isn't narrowed: scale those around 256.
patch=1,EE,0023D2AC,word,08024040   // j 0x90100
patch=1,EE,0023D2B0,word,C4A20008   // lwc1 f2,8(a1) (x)
patch=1,EE,00090100,word,3C014380   // lui at,0x4380
patch=1,EE,00090104,word,44812000   // mtc1 at,f4 (256)
patch=1,EE,00090108,word,46041081   // sub.s f2,f2,f4
patch=1,EE,0009010C,word,3C013F40   // lui at,0x3f40
patch=1,EE,00090110,word,44812800   // mtc1 at,f5 (0.75)
patch=1,EE,00090114,word,46051082   // mul.s f2,f2,f5
patch=1,EE,00090118,word,46041080   // add.s f2,f2,f4
patch=1,EE,0009011C,word,0808F4AD   // j 0x23d2b4
patch=1,EE,00090120,word,46020328   // max.s f12,f0,f2
patch=1,EE,0023D2D4,word,08024049   // j 0x90124
patch=1,EE,0023D2D8,word,C4A00010   // lwc1 f0,0x10(a1) (width)
patch=1,EE,00090124,word,46050002   // mul.s f0,f0,f5
patch=1,EE,00090128,word,0808F4B7   // j 0x23d2dc
patch=1,EE,0009012C,word,46001000   // add.s f0,f2,f0

// Clipping 2D nodes (FUN_00239030) intersect the GS scissor with their screen rectangle from FUN_00238850 (+8 x, +0x10
// width): scale them the same way.
patch=1,EE,00239060,word,08024030   // j 0x900c0
patch=1,EE,00239064,word,C4420000   // lwc1 f2,0(v0) (x)

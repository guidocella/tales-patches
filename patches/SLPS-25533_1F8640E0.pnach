patch=1,EE,000901D4,word,00000000
patch=1,EE,000901D8,word,24020156   // li v0,342
patch=1,EE,000901DC,word,080D8B22   // j 0x362c88
patch=1,EE,000901E0,word,44820000   // mtc1 v0,f0

// Event and skit portraits (FUN_0023bab0) are first composed (base, eyes, mouth) into an offscreen buffer through the 2D
// projection, then drawn from it through the projection again: widen the composed vertices' x by 4/3 so that only the second
// draw narrows them.
patch=1,EE,0023BD10,word,0C024080   // jal 0x90200
patch=1,EE,0023BD7C,word,0C024080   // jal 0x90200
patch=1,EE,0023BDF4,word,0C024080   // jal 0x90200
patch=1,EE,0023BE58,word,0C024080   // jal 0x90200
patch=1,EE,00090200,word,C4A00020   // lwc1 f0,0x20(a1) (x)
